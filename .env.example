# ---- Auth (required) ----
# Fixed password for the dashboard.
LATERHOOK_PASSWORD=change-me
# Secret used to sign the session cookie. Any long random string.
# Falls back to a value derived from the password if unset.
LATERHOOK_SECRET=

# ---- Database ----
# "d1" (Cloudflare D1 over its REST API; use this on Vercel) or "sqlite" (local file, dev only).
# When unset: "d1" if the three CLOUDFLARE_* vars are present, otherwise "sqlite".
DATABASE_DRIVER=

# Cloudflare D1. Create a database with `wrangler d1 create laterhook` (or in the dashboard)
# and an API token with the "D1:Edit" permission. The schema is created automatically.
# Prefer the LATERHOOK_D1_* names: they win over the generic CLOUDFLARE_* ones, so a
# CLOUDFLARE_API_TOKEN exported globally by your shell (e.g. for wrangler) can't shadow them.
LATERHOOK_D1_ACCOUNT_ID=
LATERHOOK_D1_DATABASE_ID=
LATERHOOK_D1_TOKEN=
# Generic fallbacks, also honoured:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# ---- Optional: D1 read replicas through the laterhook-d1 Worker ----
# D1 read replication only works through a Worker binding (Sessions API), not the REST API.
# Deploy the Worker in worker/ (see README "Read replicas"), then set both variables below:
# every query then goes through the Worker instead of the REST API, and reads are served by
# the nearest replica. The REST credentials above are not needed in that case.
LATERHOOK_D1_WORKER_URL=
# Shared secret; must match the Worker's LATERHOOK_D1_WORKER_SECRET (bun run worker:secret).
LATERHOOK_D1_WORKER_SECRET=
# "false" pins every query to the primary while still using the Worker (default true).
LATERHOOK_D1_READ_REPLICAS=

# Local SQLite file (only for DATABASE_DRIVER=sqlite).
SQLITE_PATH=.data/laterhook.db

# ---- Optional: sender geolocation via ip-api.com (Pro) ----
# When set, every sender IP is looked up once, cached, and shown on requests and the overview.
IP_API_KEY=
# Days before a cached lookup is refreshed (default 30).
IP_API_CACHE_DAYS=

# ---- Optional tuning ----
# Public origin used for the URLs shown in the UI; inferred from the request when unset.
LATERHOOK_PUBLIC_URL=
# Largest request body stored, in bytes (default 524288 = 512 KiB). Larger bodies are truncated.
LATERHOOK_MAX_BODY_BYTES=
# Timeout when forwarding/replaying to a target, in ms (default 10000).
LATERHOOK_FORWARD_TIMEOUT_MS=
# Session lifetime in seconds (default 2592000 = 30 days).
LATERHOOK_SESSION_TTL=

# ---- Optional: AI triage with TypeSafe AI's Jev via Vercel AI Gateway ----
# When both are set, every request is labelled after it's stored: sender, kind (event/test/
# handshake/probe), attention level, failure and personal-data flags. Header secrets are redacted.
# Free-tier Gateway credits are rate-limited for this model; add paid credits for steady traffic.
AI_GATEWAY_API_KEY=
# "true" to turn triage on.
TYPESAFE_AI_ENABLED=
# Gateway model id (default typesafe-ai/jev).
TYPESAFE_AI_MODEL=
